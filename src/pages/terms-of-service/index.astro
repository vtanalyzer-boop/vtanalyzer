---
import Layout from "../../layouts/Layout.astro";

const title = "Terms of Service | VT Analyzer";
const description = "The terms that govern your use of the VT Analyzer YouTube thumbnail analyzer.";

const sections = [
  {
    h: "1. Acceptance of Terms",
    p: "By accessing or using VT Analyzer (the \"Service\"), you agree to be bound by these Terms of Service and our Privacy Policy. If you do not agree to these Terms, please discontinue use of the Service immediately.",
  },
  {
    h: "2. Eligibility",
    p: "You must be at least 13 years old to use this Service. If you are under the age of majority in your jurisdiction, you may use the Service only with the involvement and consent of a parent or legal guardian.",
  },
  {
    h: "3. Description of Service",
    p: "VT Analyzer provides a free online tool that evaluates YouTube thumbnails against factors linked to click-through performance, including readability, contrast, focal point, color saturation, aspect ratio, file size, and resolution, and returns a score along with suggestions for improvement. The Service also provides educational content about thumbnail design, sizing, and YouTube's publishing requirements.",
  },
  {
    h: "4. User Responsibilities",
    p: "When using the Service, you agree to: provide accurate information where requested; use the Service only for lawful purposes; avoid uploading content that infringes copyright, trademark, or other intellectual property rights, or that is unlawful, obscene, defamatory, or harmful; refrain from attempting to disrupt, reverse-engineer, scrape, or interfere with the Service's operation; and refrain from using automated systems (bots, scripts) to access the Service at a volume that could degrade performance for other users.",
  },
  {
    h: "5. Intellectual Property",
    p: "The Service, including its design, branding, logo, scoring methodology, and underlying code, is the property of VT Analyzer and is protected by applicable intellectual property laws. You retain full ownership of any thumbnail images you analyze — we claim no rights over content you upload, and as explained in our Privacy Policy, uploaded images are processed locally in your browser rather than stored on our servers.",
  },
  {
    h: "6. No Warranty",
    p: "The Service is provided \"as is\" and \"as available\" without warranties of any kind, express or implied, including but not limited to implied warranties of merchantability, fitness for a particular purpose, and non-infringement. We do not guarantee that the Service will be uninterrupted, secure, or error-free, or that scores and suggestions will result in any particular outcome for your channel or videos.",
  },
  {
    h: "7. Limitation of Liability",
    p: "To the fullest extent permitted by law, VT Analyzer and its operators shall not be liable for any indirect, incidental, special, consequential, or punitive damages, including loss of revenue, data, or goodwill, arising from your use of, or inability to use, the Service, even if we have been advised of the possibility of such damages.",
  },
  {
    h: "8. Indemnification",
    p: "You agree to indemnify and hold VT Analyzer harmless from any claims, damages, liabilities, and expenses (including reasonable legal fees) arising from your violation of these Terms or your misuse of the Service, including any thumbnail images or content you upload.",
  },
  {
    h: "9. Third-Party Links and Services",
    p: "The Service may contain links to third-party websites or tools (such as Canva, YouTube Studio, or Google Translate) and may embed third-party services to provide features like language translation or advertising. We are not responsible for the content, accuracy, or practices of any linked or embedded third-party service, and your use of those services is governed by their own terms.",
  },
  {
    h: "10. Advertising",
    p: "The Service may display advertisements served through third-party advertising networks. We are not responsible for the content of individual advertisements, and their inclusion does not constitute an endorsement by VT Analyzer of any advertised product or service.",
  },
  {
    h: "11. Termination",
    p: "We reserve the right to suspend or terminate your access to the Service at our discretion, without notice, for conduct that we believe violates these Terms or is harmful to other users, us, or third parties.",
  },
  {
    h: "12. Changes to the Service",
    p: "We may modify, suspend, or discontinue any part of the Service at any time without prior notice, and we will not be liable for any such modification, suspension, or discontinuation.",
  },
  {
    h: "13. Severability",
    p: "If any provision of these Terms is found to be unenforceable or invalid, that provision will be limited or eliminated to the minimum extent necessary, and the remaining provisions will remain in full force and effect.",
  },
  {
    h: "14. Governing Law",
    p: "These Terms are governed by the applicable laws of India, without regard to conflict-of-law principles, and any disputes arising from these Terms shall be subject to the exclusive jurisdiction of the courts located in Indore, Madhya Pradesh.",
  },
  {
    h: "15. Changes to These Terms",
    p: "We may update these Terms from time to time to reflect changes in the Service, legal requirements, or our practices. Material changes will be reflected by updating the \"Last updated\" date at the top of this page. Continued use of the Service after changes are posted constitutes acceptance of the revised Terms.",
  },
];
---

<Layout title={title} description={description} path="/terms-of-service/">
  <section class="bg-void py-14 text-mist">
    <div class="mx-auto max-w-3xl px-5">
      <h1 class="font-display text-3xl font-bold sm:text-4xl">Terms of Service</h1>
      <p class="mt-3 text-sm text-mist/50">Last updated: July 1, 2026</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl space-y-8 px-5 py-16 text-sm leading-relaxed text-ink/70 dark:text-smoke sm:text-base">
    <p>Please read these Terms of Service carefully before using our YouTube thumbnail analyzer.</p>
    {sections.map((s) => (
      <div>
        <h2 class="font-display text-lg font-bold text-ink dark:text-fog">{s.h}</h2>
        <p class="mt-2">{s.p}</p>
      </div>
    ))}
    <div>
      <h2 class="font-display text-lg font-bold text-ink dark:text-fog">Contact</h2>
      <p class="mt-2">
        Questions about these Terms? Email
        <a href="mailto:vtanalyze@gmail.com" class="text-red underline underline-offset-2">vtanalyze@gmail.com</a>.
      </p>
    </div>
  </section>
</Layout>
