---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Something Went Wrong | VT Analyzer" description="Something went wrong on our end." path="/500/" noindex={true}>
  <section class="flex min-h-[70vh] items-center justify-center bg-void text-mist">
    <div class="mx-auto max-w-md px-5 text-center">
      <p class="font-mono-num text-6xl font-bold text-red">500</p>
      <h1 class="mt-4 font-display text-2xl font-bold">Something went wrong on our end</h1>
      <p class="mt-3 text-mist/60">We hit an unexpected error. Please try again in a moment.</p>
      <a href="/" class="mt-8 inline-block rounded-sm bg-red px-6 py-3 text-sm font-semibold text-white hover:bg-red-dark">
        Back to Home
      </a>
    </div>
  </section>
</Layout>
