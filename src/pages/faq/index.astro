---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import { faqs } from "../../data/faqs";

const title = "YouTube Thumbnail FAQ — Size, Dimensions, Aspect Ratio & Rules | VT Analyzer";
const description =
  "Answers to the most common YouTube thumbnail questions: exact size and dimensions in pixels, aspect ratio, resolution, Canva and ChatGPT tools, MrBeast-style thumbnails, and YouTube's rules.";

const categories = [...new Set(faqs.map((f) => f.category))];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};
---

<Layout title={title} description={description} path="/faq/" jsonLd={jsonLd}>
  <PageHero eyebrow="FAQ" title="YouTube Thumbnail Questions, Answered" description="Everything creators ask about thumbnail size, thumbnail makers, thumbnail checkers, and what YouTube allows — in one place." art="/img/hero/hero-faq.svg" />

  <section class="mx-auto max-w-4xl px-5 py-16">
    <div class="flex flex-wrap gap-2">
      {categories.map((c) => (
        <span class="rounded-full border border-ink/15 dark:border-seam px-3 py-1 text-xs font-medium text-ink/60 dark:text-smoke">{c}</span>
      ))}
    </div>

    <div class="mt-8">
      <FaqAccordion items={faqs} />
    </div>

    <div class="mt-14 rounded-sm border border-ink/10 dark:border-seam bg-paper-dim dark:bg-night-dim p-8 text-center">
      <h2 class="font-display text-xl font-bold text-ink dark:text-fog">Still have a question about your thumbnail?</h2>
      <p class="mt-2 text-sm text-ink/60 dark:text-smoke">Run it through the free analyzer or send us a message.</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href="/#analyzer" class="rounded-sm bg-red-dark px-5 py-2.5 text-sm font-semibold text-white hover:bg-red-darker">
          Analyze a Thumbnail
        </a>
        <a href="/contact/" class="rounded-sm border border-ink/20 dark:border-seam px-5 py-2.5 text-sm font-semibold text-ink dark:text-fog hover:border-ink/40 dark:border-seam">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
