---
import Layout from "../../layouts/Layout.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import { faqs } from "../../data/faqs";

const title = "YouTube Thumbnail FAQ — Sizes, Tools & Rules Explained | VT Analyzer";
const description =
  "Answers to the most common YouTube thumbnail questions: sizing, Canva and ChatGPT tools, MrBeast and Fortnite thumbnail styles, thumbnail checkers, and YouTube's thumbnail rules.";

const categories = [...new Set(faqs.map((f) => f.category))];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};
---

<Layout title={title} description={description} path="/faq/" jsonLd={jsonLd}>
  <section class="bg-void py-16 text-mist sm:py-20">
    <div class="mx-auto max-w-4xl px-5 text-center">
      <p class="font-mono-num text-xs uppercase tracking-[0.25em] text-red">FAQ</p>
      <h1 class="mt-3 font-display text-4xl font-bold sm:text-5xl">YouTube Thumbnail Questions, Answered</h1>
      <p class="mx-auto mt-4 max-w-2xl text-mist/60">
        Everything creators ask about thumbnail size, thumbnail makers, thumbnail checkers, and
        what YouTube allows — in one place.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16">
    <div class="flex flex-wrap gap-2">
      {categories.map((c) => (
        <span class="rounded-full border border-ink/15 dark:border-seam px-3 py-1 text-xs font-medium text-ink/60 dark:text-smoke">{c}</span>
      ))}
    </div>

    <div class="mt-8">
      <FaqAccordion items={faqs} />
    </div>

    <div class="mt-14 rounded-sm border border-ink/10 dark:border-seam bg-paper-dim dark:bg-night-dim p-8 text-center">
      <h2 class="font-display text-xl font-bold text-ink dark:text-fog">Still have a question about your thumbnail?</h2>
      <p class="mt-2 text-sm text-ink/60 dark:text-smoke">Run it through the free analyzer or send us a message.</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href="/#analyzer" class="rounded-sm bg-red px-5 py-2.5 text-sm font-semibold text-white hover:bg-red-dark">
          Analyze a Thumbnail
        </a>
        <a href="/contact/" class="rounded-sm border border-ink/20 dark:border-seam px-5 py-2.5 text-sm font-semibold text-ink dark:text-fog hover:border-ink/40 dark:border-seam">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
