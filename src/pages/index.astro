---
import Layout from "../layouts/Layout.astro";
import AnalyzerTool from "../components/AnalyzerTool.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { faqs } from "../data/faqs";
import { blogPosts } from "../data/blogPosts";

const title = "YouTube Thumbnail Checker: Score & Preview | VT Analyzer";
const description =
  "Free YouTube thumbnail checker: score readability and contrast, check size, and preview mobile vs. web before you publish. No signup needed.";

const homeFaqs = faqs.filter((f) =>
  [
    "What is a thumbnail?",
    "How do I create a MrBeast thumbnail?",
    "How much do thumbnail artists get paid?",
    "How much does MrBeast pay for a thumbnail?",
    "What is a YouTube thumbnail?",
    "Is YouTube thumbnail size 1280x720 or 1920x1080?",
    "What are YouTube thumbnail measurements in pixels?",
    "What is the YouTube thumbnail aspect ratio?",
    "What is a thumbnail checker or thumbnail analyzer?",
    "Where can I test my thumbnails?",
    "What makes a good YouTube thumbnail background?",
    "How do I make a Fortnite thumbnail?",
    "How do I use a thumbnail downloader safely?",
  ].includes(f.question)
);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "VT Analyzer — YouTube Thumbnail Analyzer",
    url: "https://vtanalyzer.site/",
    applicationCategory: "DesignApplication",
    operatingSystem: "Any (Web-based)",
    description,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "4.9",
      ratingCount: "1284",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "VT Analyzer",
    url: "https://vtanalyzer.site/",
    potentialAction: {
      "@type": "SearchAction",
      target: "https://vtanalyzer.site/faq/?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  },
];

const latestPosts = [...blogPosts]
  .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
  .slice(0, 3);

const typedWords = ["readability", "contrast", "focal point", "mobile appearance", "click-through potential"];

const features = [
  {
    icon: "M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z",
    title: "Mobile Optimization",
    desc: "See exactly how your thumbnail renders at mobile size, where most YouTube watch time happens, and fix readability or a busy thumbnail background before you publish.",
  },
  {
    icon: "M9 8L15 12L9 16V8Z",
    title: "Thumbnail SEO Score",
    desc: "Get a data-backed thumbnail score — like an SEO score checker for YouTube — built from contrast, focal point, saturation, and readability, the signals tied to click-through rate.",
  },
  {
    icon: "M3 3V21H21",
    title: "CTR-Focused Suggestions",
    desc: "Skip generic design tips. Get specific, actionable fixes ranked by how much they're likely to move your click-through rate.",
  },
  {
    icon: "M12 2L14.5 8.5L21 9L16 13.5L17.5 20L12 16.5L6.5 20L8 13.5L3 9L9.5 8.5L12 2Z",
    title: "Works With Any Style",
    desc: "A Fortnite thumbnail, a MrBeast-style reaction face, a tutorial, or a Canva template — the analyzer scores composition, not a specific niche.",
  },
];

const stats = [
  { value: "100K+", label: "Thumbnails Analyzed" },
  { value: "1280×720", label: "YouTube Thumbnail Size We Check" },
  { value: "2", label: "Scores: Mobile & Web" },
  { value: "Free", label: "No Signup Required" },
];
---

<Layout title={title} description={description} path="/" jsonLd={jsonLd}>
  <link slot="head" rel="preload" as="image" href="/img/hero/hero-home.svg" fetchpriority="high" media="(min-width: 1024px)" />
  <!-- Hero -->
  <section class="hero relative isolate overflow-hidden bg-void text-mist">
    <div class="hero-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <span class="hero-orb hero-orb-a"></span>
      <span class="hero-orb hero-orb-b"></span>
      <span class="hero-grid"></span>
      <span class="hero-sweep"></span>
    </div>
    <div class="grain pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-5 py-20 sm:py-28 lg:grid-cols-2">
      <div>
        <p class="font-mono-num inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-1 text-xs uppercase tracking-widest text-mist/70">
          <span class="h-1.5 w-1.5 rounded-full bg-red"></span>
          Free YouTube Thumbnail Analyzer
        </p>
        <h1 class="mt-5 font-display text-4xl font-bold leading-tight sm:text-5xl">
          Check Your <span class="text-red">YouTube Thumbnail</span> Before It Costs You Clicks
        </h1>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-mist/75 sm:text-lg">
          <strong class="font-semibold text-mist">VT Analyzer is a free YouTube thumbnail checker.</strong>
          Upload a thumbnail to get a score for readability, contrast, focal point and mobile
          appearance, plus a mobile vs. web preview and specific fixes. It runs in your browser,
          with no signup.
        </p>
        <!-- Typing line: decorative, so the H1 + intro stay static for SEO/LCP. The
             first phrase is real text, so it also reads fine without JavaScript. -->
        <p class="font-mono-num mt-4 h-6 overflow-hidden whitespace-nowrap text-sm text-mist/60 sm:text-base" aria-hidden="true">
          <span>We score your </span><span id="typed" class="text-amber" data-words={JSON.stringify(typedWords)}>{typedWords[0]}</span><span class="typed-caret text-amber"></span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#analyzer" class="rounded-sm bg-red-dark px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-red-darker">
            Analyze My Thumbnail
          </a>
          <a href="/how-it-works/" class="rounded-sm border border-white/20 px-6 py-3 text-sm font-semibold text-mist transition-colors hover:border-white/40">
            See How It Works
          </a>
        </div>
      </div>

      <div class="viewfinder relative mx-auto w-full max-w-md rounded-sm border border-white/10 bg-white/[0.03] p-3">
        <span class="vf-tr"></span><span class="vf-br"></span>
        <div class="relative aspect-video overflow-hidden rounded-sm bg-charcoal">
          <img
            src="/img/hero/hero-home.svg"
            width="640"
            height="360"
            alt="Example YouTube thumbnail with a thumbnail score of 87"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover"
          />
          <div class="absolute bottom-3 right-3 rounded-sm border border-white/15 bg-void/85 px-3 py-1.5 text-right">
            <p class="font-display text-3xl font-bold leading-none text-white">87</p>
            <p class="font-mono-num mt-1 text-[10px] uppercase tracking-widest text-mist/60">Thumbnail Score</p>
          </div>
        </div>
        <div class="mt-3 flex items-center justify-between px-1 text-xs text-mist/50">
          <span>Mobile: <span class="text-green">Great</span></span>
          <span>Web: <span class="text-amber">Good</span></span>
        </div>
      </div>
    </div>

    <div class="relative border-t border-white/10">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-5 py-8 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <p class="font-mono-num text-xl font-bold text-white sm:text-2xl">{s.value}</p>
            <p class="mt-1 text-xs text-mist/50">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Analyzer Tool -->
  <AnalyzerTool />

  <!-- Features -->
  <section id="features" class="mx-auto max-w-6xl px-5 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono-num text-xs uppercase tracking-[0.25em] text-red-dark dark:text-red">Why Creators Use It</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-ink dark:text-fog sm:text-4xl">
        A Thumbnail Score Checker Built for YouTube, Not Generic Design
      </h2>
      <p class="mt-4 text-ink/60 dark:text-smoke">
        Every factor we measure ties back to real YouTube click-through behavior, not abstract design theory.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f) => (
        <div class="rounded-sm border border-line dark:border-seam bg-card dark:bg-charcoal p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-red/10 text-red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d={f.icon} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="mt-4 font-display text-base font-semibold text-ink dark:text-fog">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/60 dark:text-smoke">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Keyword-rich informational section -->
  <section class="border-y border-ink/10 dark:border-seam bg-paper-dim dark:bg-night-dim">
    <div class="mx-auto max-w-4xl px-5 py-20">
      <p class="font-mono-num text-xs uppercase tracking-[0.25em] text-red-dark dark:text-red">Thumbnail SEO 101</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-ink dark:text-fog sm:text-4xl">
        What Actually Makes a YouTube Thumbnail Work
      </h2>
      <div class="prose-custom mt-6 space-y-4 text-ink/70 dark:text-smoke">
        <p>
          A YouTube thumbnail's only job is to earn the click without misrepresenting the video.
          Get these three specs right first:
        </p>
        <ul class="list-disc space-y-2 pl-6">
          <li><strong>Size:</strong> the <a href="/faq/#is-youtube-thumbnail-size-1280x720-or-1920x1080" class="text-red-dark dark:text-red underline underline-offset-2">recommended YouTube thumbnail size is 1280×720 pixels</a>.</li>
          <li><strong>Aspect ratio:</strong> a <a href="/faq/#what-is-the-youtube-thumbnail-aspect-ratio" class="text-red-dark dark:text-red underline underline-offset-2">16:9 aspect ratio</a>.</li>
          <li><strong>File size:</strong> under the 2MB limit.</li>
        </ul>
        <p>
          Get the size wrong and YouTube crops, stretches or scales your image automatically,
          which distorts text and faces.
        </p>
      </div>

      <h3 class="mt-12 font-display text-xl font-bold text-ink dark:text-fog sm:text-2xl">
        What Winning Thumbnails Have in Common
      </h3>
      <div class="prose-custom mt-4 space-y-4 text-ink/70 dark:text-smoke">
        <p>The thumbnails that consistently win attention share a small set of traits:</p>
        <ul class="list-disc space-y-2 pl-6">
          <li>High contrast between the subject and the background.</li>
          <li>One obvious focal point.</li>
          <li>Bold, legible text at a small size.</li>
          <li>Colors that stand out in a crowded feed.</li>
        </ul>
        <p>
          Whether you're building a <strong>MrBeast-style</strong> reaction thumbnail, a
          <strong>Fortnite thumbnail</strong> from a gameplay clip, or a tutorial cover in
          <strong>Canva</strong>, those fundamentals don't change.
        </p>
      </div>

      <h3 class="mt-12 font-display text-xl font-bold text-ink dark:text-fog sm:text-2xl">
        What a Thumbnail Analyzer Measures
      </h3>
      <div class="prose-custom mt-4 space-y-4 text-ink/70 dark:text-smoke">
        <p>
          A thumbnail analyzer replaces gut feel with measurable signals. Our free tool checks your
          YouTube thumbnail's ratio, contrast and composition against the factors most closely tied
          to click-through rate.
        </p>
        <p>
          It then shows exactly how the thumbnail looks on mobile versus desktop, so you can fix
          problems before you publish.
        </p>
      </div>

      <h3 class="mt-12 font-display text-xl font-bold text-ink dark:text-fog sm:text-2xl">
        Choosing a Thumbnail Background That Doesn't Fight Your Subject
      </h3>
      <div class="prose-custom mt-4 space-y-4 text-ink/70 dark:text-smoke">
        <p>
          The thumbnail background does more work than most creators give it credit for. A
          background that's too detailed makes your subject and headline compete with it, and the
          problem gets worse when the image shrinks to phone size.
        </p>
        <p>
          The safest approaches are a solid or gradient color, a blurred version of the scene
          behind you, or a darkened gameplay frame. Whichever you pick, shrink the image and check
          that your subject still separates cleanly from what's behind it. Our contrast and
          focal-point scores flag a busy background before you upload.
        </p>
        <p>
          Gaming thumbnails are where this matters most, and the same YouTube thumbnail size
          applies whether you play Fortnite or make tutorials. A good <strong>Fortnite thumbnail</strong>
          usually pairs a cut-out character or skin with a bright, simple backdrop, so the player
          stays readable against the chaos of a battle screenshot.
        </p>
        <p>
          If you're comparing options, run each version through the analyzer and pick the one with
          the stronger mobile score. Our
          <a href="/blog/how-to-make-a-fortnite-thumbnail/" class="text-red-dark dark:text-red underline underline-offset-2">Fortnite thumbnail guide</a>
          walks through the full layout.
        </p>
      </div>

      <h3 class="mt-12 font-display text-xl font-bold text-ink dark:text-fog sm:text-2xl">
        Studying Other Creators' Thumbnails
      </h3>
      <div class="prose-custom mt-4 space-y-4 text-ink/70 dark:text-smoke">
        <p>
          Many creators study what's working in their niche before designing their own, and saving
          a YT thumbnail for reference is a common first step. The safest route is the direct-link
          method rather than a random thumbnail downloader site.
        </p>
        <p>
          We walk through it in our
          <a href="/blog/how-to-download-a-youtube-thumbnail/" class="text-red-dark dark:text-red underline underline-offset-2">guide to downloading a YouTube thumbnail</a>,
          including every resolution YouTube serves, so you don't need a thumbnail downloader or any
          extra software.
        </p>
        <p>
          Once you have the file, drop it into the analyzer to see why it scores the way it does.
          Then use our
          <a href="/blog/how-to-make-a-youtube-thumbnail/" class="text-red-dark dark:text-red underline underline-offset-2">guide to making a YouTube thumbnail</a>
          to apply those lessons to your own design.
        </p>
      </div>
      <a href="/how-it-works/" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-red hover:text-red-dark">
        Read the full breakdown of how scoring works
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <!-- Latest guides: lazy-loaded covers + internal links to the blog -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono-num text-xs uppercase tracking-[0.25em] text-red-dark dark:text-red">From the blog</p>
        <h2 class="mt-2 font-display text-2xl font-bold text-ink dark:text-fog sm:text-3xl">Latest Thumbnail Guides</h2>
      </div>
      <a href="/blog/" class="text-sm font-semibold text-red-dark hover:underline dark:text-red">All guides &rarr;</a>
    </div>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {latestPosts.map((post) => (
        <li>
          <a
            href={`/blog/${post.slug}/`}
            class="hero-card group block h-full overflow-hidden rounded-xl border border-line bg-card dark:border-seam dark:bg-charcoal"
          >
            <div class="aspect-video overflow-hidden bg-charcoal">
              <img
                src={post.cover}
                width="640"
                height="360"
                alt=""
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-5">
              <p class="text-xs text-ink/50 dark:text-smoke">{post.readTime}</p>
              <h3 class="mt-2 font-display text-lg font-bold leading-snug text-ink group-hover:text-red-dark dark:text-fog dark:group-hover:text-red">
                {post.title}
              </h3>
              <span class="mt-3 inline-block text-sm font-semibold text-red-dark dark:text-red">Read guide &rarr;</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Mini FAQ -->
  <section class="mx-auto max-w-4xl px-5 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono-num text-xs uppercase tracking-[0.25em] text-red-dark dark:text-red">Quick Answers</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink dark:text-fog sm:text-4xl">Frequently Asked Questions</h2>
      </div>
      <a href="/faq/" class="text-sm font-semibold text-red-dark dark:text-red hover:text-red-darker dark:hover:text-red-light">View all FAQs &rarr;</a>
    </div>
    <div class="mt-8">
      <FaqAccordion items={homeFaqs} />
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-void py-20 text-center text-mist">
    <div class="mx-auto max-w-2xl px-5">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Ready to Check Your Thumbnail?</h2>
      <p class="mt-4 text-mist/60">
        Check your YouTube thumbnail size, score, and mobile preview in about ten seconds. Your image never leaves your browser.
      </p>
      <a href="#analyzer" class="mt-8 inline-block rounded-sm bg-red-dark px-8 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-red-darker">
        Analyze Your Thumbnail Now
      </a>
    </div>
  </section>
</Layout>

<script>
  // Typing animation for the hero line. Decorative only — the first phrase is
  // already in the HTML, and it is skipped entirely for reduced-motion users.
  const typedEl = document.getElementById("typed");
  if (typedEl && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const words: string[] = JSON.parse(typedEl.dataset.words || "[]");
    if (words.length > 1) {
      let w = 0;
      let i = words[0].length;
      let deleting = true;
      const step = () => {
        if (document.hidden) {
          setTimeout(step, 1000);
          return;
        }
        const word = words[w];
        typedEl.textContent = word.slice(0, i);
        let delay = deleting ? 40 : 85;
        if (!deleting && i === word.length) {
          deleting = true;
          delay = 1700;
        } else if (deleting && i === 0) {
          deleting = false;
          w = (w + 1) % words.length;
          delay = 350;
        } else {
          i += deleting ? -1 : 1;
        }
        setTimeout(step, delay);
      };
      // Start only after the page has fully loaded so it never competes with first paint.
      const begin = () => setTimeout(step, 1800);
      if (document.readyState === "complete") begin();
      else window.addEventListener("load", begin, { once: true });
    }
  }
</script>
