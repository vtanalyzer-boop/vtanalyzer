---
import Layout from "../../layouts/Layout.astro";
import { blogPosts } from "../../data/blogPosts";

const title = "Blog — YouTube Thumbnail Guides & Tips | VT Analyzer";
const description =
  "Guides on making, sizing, and testing YouTube thumbnails — practical, step-by-step advice to help your videos earn more clicks.";

const sortedPosts = [...blogPosts].sort(
  (a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime()
);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout title={title} description={description} path="/blog/">
  <section class="bg-void py-16 text-mist sm:py-20">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <p class="font-mono-num text-xs uppercase tracking-[0.25em] text-red">Blog</p>
      <h1 class="mt-3 font-display text-4xl font-bold sm:text-5xl">YouTube Thumbnail Guides</h1>
      <p class="mt-4 text-sm leading-relaxed text-mist/70 sm:text-base">
        Practical, step-by-step guides on making, sizing, and testing YouTube thumbnails — no vague
        "make it pop" advice.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16">
    <ul class="divide-y divide-ink/10 dark:divide-seam">
      {sortedPosts.map((post) => (
        <li class="py-8 first:pt-0">
          <a href={`/blog/${post.slug}/`} class="group block">
            <p class="text-xs text-ink/40 dark:text-smoke">
              <time datetime={post.publishDate}>{formatDate(post.publishDate)}</time>
              <span aria-hidden="true"> &middot; </span>
              {post.readTime}
            </p>
            <h2 class="mt-2 font-display text-xl font-bold text-ink dark:text-fog group-hover:text-red-dark dark:group-hover:text-red sm:text-2xl">
              {post.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-ink/65 dark:text-smoke sm:text-base">{post.excerpt}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-red-dark dark:text-red">Read guide &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-line dark:border-seam bg-paper-dim dark:bg-night-dim py-16">
    <div class="prose-custom mx-auto max-w-3xl space-y-5 px-5 text-sm leading-relaxed text-ink/70 dark:text-smoke sm:text-base">
      <h2 class="font-display text-2xl font-bold text-ink dark:text-fog">Why We Write About Thumbnails</h2>
      <p>
        A thumbnail does more work, in less time, than almost any other piece of content a creator
        makes. It has to communicate what a video is about, signal tone and quality, and win out
        against a dozen competing thumbnails in the same feed — all in roughly the half-second a
        viewer's eye actually spends on it. Most advice about thumbnails treats that as a purely
        artistic problem: "make it bold," "use bright colors," "add a face." None of that explains
        why one thumbnail works and a visually similar one doesn't.
      </p>
      <p>
        This blog exists to go one layer deeper than that. Every guide here is built around a
        specific, answerable question — not "how do I make my thumbnail better" in the abstract, but
        "what size does YouTube actually require," "where do I get a template if I have no design
        background," or "how do I pull a reference image down to study it." The goal is always a
        concrete next step you can act on immediately, not a mood board of inspiration.
      </p>
      <h3 class="font-display text-lg font-bold text-ink dark:text-fog">What You'll Find Here</h3>
      <p>
        Expect three kinds of posts going forward. Practical how-to guides that walk through an exact
        process — making a thumbnail from scratch, downloading one for reference, exporting a frame
        from your own footage. Technical reference posts that answer a specific spec question in
        full, the same way our <a href="/faq/" class="text-red-dark dark:text-red underline underline-offset-2">FAQ</a> does
        but with more room to explain the reasoning. And, over time, teardown-style posts that look
        at what specific high-performing thumbnails are actually doing — contrast, composition, text
        placement — rather than describing good design in the abstract.
      </p>
      <h3 class="font-display text-lg font-bold text-ink dark:text-fog">Who This Blog Is For</h3>
      <p>
        Most of what's written here assumes no design background at all. If you've never opened a
        design tool before, the goal is to get you from a blank page to a finished, decent thumbnail
        using free tools, not to teach you design theory first. If you already have a workflow and
        just want to tighten it up — faster exports, a repeatable template, a sharper eye for what's
        actually wrong with a draft — there's something here for that too. The common thread across
        every post is that it's written for someone who publishes videos regularly and needs answers
        fast, not for someone browsing design inspiration with no deadline.
      </p>
      <h3 class="font-display text-lg font-bold text-ink dark:text-fog">How Often We Publish</h3>
      <p>
        New guides go up as they're finished rather than on a fixed weekly schedule — we'd rather
        publish something thorough less often than pad out a content calendar with short, thin posts.
        Each one is written to stand on its own: you shouldn't need to have read three previous posts
        to get value out of the one you clicked on. Where a post does build on something covered
        elsewhere on the site — a size spec, a scoring factor — it links directly to that page rather
        than repeating it, so you're never reading the same explanation twice.
      </p>
      <p>
        If a guide here raises a question it doesn't fully answer, or you'd like to see a specific
        topic covered,
        <a href="/contact/" class="text-red-dark dark:text-red underline underline-offset-2">reach out</a> —
        reader questions are usually where the next post idea comes from. And once you've got a
        thumbnail ready, our
        <a href="/" class="text-red-dark dark:text-red underline underline-offset-2">free analyzer</a>
        is the fastest way to check it before you publish.
      </p>
    </div>
  </section>
</Layout>
