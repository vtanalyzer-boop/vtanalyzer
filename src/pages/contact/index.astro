---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";

const title = "Contact VT Analyzer — Support, Feedback & Partnerships";
const description =
  "Get in touch with the VT Analyzer team for support, feedback, feature requests, or agency partnership inquiries about our YouTube thumbnail analyzer.";

const commonQuestions = [
  {
    q: "How long does it take to get a response?",
    a: "We aim to answer every message within one business day. For anything urgent, mention it in your subject line.",
  },
  {
    q: "Do you offer custom solutions for agencies?",
    a: "Yes — we work with agencies and content networks. Share a few details about your team in the message below and we'll follow up with options.",
  },
  {
    q: "Can I suggest a new feature for the analyzer?",
    a: "Always welcome. Feature requests submitted through this form go straight to our product notes for upcoming updates.",
  },
];
---

<Layout title={title} description={description} path="/contact/">
  <PageHero eyebrow="Contact" title="Get In Touch" description="Questions about the analyzer, feedback, or a partnership idea — we're happy to hear it." art="/img/hero/hero-contact.svg" />

  <section class="mx-auto grid max-w-5xl grid-cols-1 gap-12 px-5 py-20 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <h2 class="font-display text-xl font-bold text-ink dark:text-fog">Reach Us Directly</h2>
      <div class="mt-6 space-y-6">
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm bg-red/10 text-red">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 8L10.89 13.26C11.5 13.67 12.5 13.67 13.11 13.26L21 8M5 19H19C20.1 19 21 18.1 21 17V7C21 5.9 20.1 5 19 5H5C3.9 5 3 5.9 3 7V17C3 18.1 3.9 19 5 19Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div>
            <h3 class="font-display text-sm font-semibold text-ink dark:text-fog">Email Us</h3>
            <a href="mailto:vtanalyze@gmail.com" class="text-sm text-red-dark dark:text-red">vtanalyze@gmail.com</a>
            <p class="mt-1 text-xs text-ink/50 dark:text-smoke">We typically respond within 24 hours.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm bg-red/10 text-red">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7V12L15 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <div>
            <h3 class="font-display text-sm font-semibold text-ink dark:text-fog">Support Hours</h3>
            <p class="text-sm text-ink/60 dark:text-smoke">Monday–Friday, 9AM–5PM EST</p>
          </div>
        </div>
      </div>

      <h2 class="mt-12 font-display text-xl font-bold text-ink dark:text-fog">Common Questions</h2>
      <div class="mt-4 divide-y divide-ink/10 dark:divide-seam border-t border-ink/10 dark:border-seam">
        {commonQuestions.map((c) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer items-center justify-between gap-3">
              <span class="text-sm font-semibold text-ink dark:text-fog">{c.q}</span>
              <span class="accordion-icon shrink-0 text-ink/40 dark:text-smoke transition-transform">+</span>
            </summary>
            <p class="mt-2 text-sm text-ink/60 dark:text-smoke">{c.a}</p>
          </details>
        ))}
      </div>
    </div>

    <form
      class="lg:col-span-3 rounded-sm border border-line dark:border-seam bg-card dark:bg-charcoal p-6 sm:p-8"
      action="mailto:vtanalyze@gmail.com"
      method="post"
      enctype="text/plain"
    >
      <h2 class="font-display text-xl font-bold text-ink dark:text-fog">Send Us a Message</h2>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="text-xs font-semibold uppercase tracking-wide text-ink/50 dark:text-smoke">Your Name</label>
          <input id="name" name="name" type="text" required class="mt-2 w-full rounded-sm border border-ink/15 dark:border-seam px-3 py-2.5 text-sm focus:border-red focus:outline-none" />
        </div>
        <div>
          <label for="email" class="text-xs font-semibold uppercase tracking-wide text-ink/50 dark:text-smoke">Email Address</label>
          <input id="email" name="email" type="email" required class="mt-2 w-full rounded-sm border border-ink/15 dark:border-seam px-3 py-2.5 text-sm focus:border-red focus:outline-none" />
        </div>
        <div class="sm:col-span-2">
          <label for="subject" class="text-xs font-semibold uppercase tracking-wide text-ink/50 dark:text-smoke">Subject</label>
          <input id="subject" name="subject" type="text" required class="mt-2 w-full rounded-sm border border-ink/15 dark:border-seam px-3 py-2.5 text-sm focus:border-red focus:outline-none" />
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="text-xs font-semibold uppercase tracking-wide text-ink/50 dark:text-smoke">Your Message</label>
          <textarea id="message" name="message" rows="5" required class="mt-2 w-full rounded-sm border border-ink/15 dark:border-seam px-3 py-2.5 text-sm focus:border-red focus:outline-none"></textarea>
        </div>
      </div>
      <button type="submit" class="mt-6 w-full rounded-sm bg-red-dark px-6 py-3 text-sm font-semibold text-white hover:bg-red-darker sm:w-auto">
        Send Message
      </button>
    </form>
  </section>

  <section class="border-t border-line dark:border-seam bg-paper-dim dark:bg-night-dim py-16">
    <div class="prose-custom mx-auto max-w-3xl space-y-5 px-5 text-sm leading-relaxed text-ink/70 dark:text-smoke sm:text-base">
      <h2 class="font-display text-2xl font-bold text-ink dark:text-fog">What to Expect When You Reach Out</h2>
      <p>
        VT Analyzer is run by a small team, not a large support department, which cuts both ways:
        responses take a little longer to arrive than an automated help desk, but a real person who
        understands the tool actually reads and answers every message. We'd rather give you one
        correct answer a few hours later than a generic canned reply in five minutes.
      </p>
      <p>
        Most messages we get fall into a few categories: a question about how the thumbnail score is
        calculated, a bug report where the analyzer didn't behave as expected, a feature request, or
        an agency asking about using the tool across a larger team. All of them are welcome here —
        there's no question too small or too technical.
      </p>
      <h3 class="font-display text-lg font-bold text-ink dark:text-fog">How to Get a Faster, More Useful Reply</h3>
      <p>
        If you're reporting a problem with the analyzer, the single most useful thing you can include
        is the thumbnail image itself (or a link to it) along with the score or behavior you saw —
        screenshots help enormously. Mentioning your browser and whether you're on desktop or mobile
        narrows things down fast, since a handful of issues only show up on specific combinations of
        the two. For feature requests, a quick sentence on the actual workflow you're trying to solve
        is more useful to us than the feature description alone — it helps us build the right version
        of what you're asking for rather than a literal one.
      </p>
      <h3 class="font-display text-lg font-bold text-ink dark:text-fog">Before You Send a Message</h3>
      <p>
        A good number of questions we receive are already answered faster through self-serve
        resources than by waiting on a reply. If your question is about thumbnail size, dimensions,
        aspect ratio, or file format, our
        <a href="/faq/" class="text-red-dark dark:text-red underline underline-offset-2">FAQ page</a>
        covers the most common versions of that in detail. If you're curious exactly how the
        analyzer's score is calculated and weighted, that's laid out step by step on the
        <a href="/how-it-works/" class="text-red-dark dark:text-red underline underline-offset-2">how it works page</a>.
        And if you're looking for practical guidance on actually designing or downloading a
        thumbnail, the
        <a href="/blog/" class="text-red-dark dark:text-red underline underline-offset-2">blog</a>
        has step-by-step guides for exactly that. Checking there first often gets you an answer
        immediately instead of waiting for a reply.
      </p>
      <h3 class="font-display text-lg font-bold text-ink dark:text-fog">After You Submit</h3>
      <p>
        Messages sent through the form above go straight to our inbox — there's no ticket system or
        queue to get lost in. You'll get a reply directly at the email address you provide, usually
        within one business day. Messages sent over the weekend are picked up the next business day.
        If you haven't heard back after a few days, it's worth checking your spam folder before
        resending, since that's the most common reason a reply doesn't land.
      </p>
    </div>
  </section>
</Layout>
