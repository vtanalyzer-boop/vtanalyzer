---
import type { Faq } from "../data/faqs";

export interface Props {
  items: Faq[];
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
---

<div class="divide-y divide-ink/10 dark:divide-seam border-t border-b border-ink/10 dark:border-seam">
  {items.map((item, i) => (
    <details id={slugify(item.question)} class="group scroll-mt-24 py-5" open={openFirst && i === 0}>
      <summary class="flex cursor-pointer items-center justify-between gap-4 text-left">
        <span class="font-display text-base font-semibold text-ink dark:text-fog sm:text-lg">{item.question}</span>
        <span class="accordion-icon flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink/20 dark:border-seam text-ink dark:text-fog transition-transform duration-200">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
      </summary>
      <p class="mt-3 max-w-3xl pr-10 text-sm leading-relaxed text-ink/65 dark:text-smoke sm:text-base">
        {item.answer}
      </p>
    </details>
  ))}
</div>
