---
export interface Props {
  class?: string;
  textClass?: string;
}
const { class: className = "", textClass = "" } = Astro.props;
---

<a href="/" class:list={["flex items-center gap-2.5 font-display text-lg font-bold tracking-tight", className]}>
  <img src="/logo.svg" alt="VT Analyzer logo" width="32" height="32" loading="eager" decoding="async" class="h-8 w-8 shrink-0 rounded-md" />
  <span class:list={textClass}>VT&nbsp;Analyzer</span>
</a>
