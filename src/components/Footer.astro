---

<footer class="border-t border-white/10 bg-void text-mist/80">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <Logo class="text-white" />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-mist/60">
          A free YouTube thumbnail analyzer and thumbnail checker. Upload any thumbnail and get an
          instant thumbnail score, mobile vs. web preview, and clear thumbnail SEO suggestions to
          raise your click-through rate.
        </p>

        <address class="mt-6 flex gap-3 not-italic text-sm text-mist/55">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mt-0.5 shrink-0" aria-hidden="true">
            <path d="M12 21C12 21 19 15.5 19 10.5C19 6.4 15.9 3 12 3C8.1 3 5 6.4 5 10.5C5 15.5 12 21 12 21Z" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="10.5" r="2.5" stroke="currentColor" stroke-width="1.8" />
          </svg>
          <span>
            202, Princes Business Park, Vijay Nagar,<br />
            Indore, Madhya Pradesh, India — Pin 425010
          </span>
        </address>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">Tool</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-mist/60">
          <li><a href="/#analyzer" class="hover:text-red">Thumbnail Analyzer</a></li>
          <li><a href="/how-it-works/" class="hover:text-red">How It Works</a></li>
          <li><a href="/faq/" class="hover:text-red">FAQ</a></li>
          <li><a href="/about/" class="hover:text-red">About Us</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">Legal</h3>
        <ul class="mt-4 space-y-2.5 text-sm text-mist/60">
          <li><a href="/privacy-policy/" class="hover:text-red">Privacy Policy</a></li>
          <li><a href="/terms-of-service/" class="hover:text-red">Terms of Service</a></li>
          <li><a href="/disclaimer/" class="hover:text-red">Disclaimer</a></li>
          <li><a href="/contact/" class="hover:text-red">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-6 border-t border-white/10 pt-8 sm:flex-row">
      <p class="text-xs text-mist/40">&copy; {year} VT Analyzer. All rights reserved.</p>

      <ul class="flex flex-wrap items-center justify-center gap-2 text-xs text-mist/50">
        {socials.map((s, i) => (
          <>
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="inline-flex items-center gap-1.5 rounded-md px-2 py-1.5 transition-colors hover:text-red"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d={s.path} />
                </svg>
                <span class="hidden sm:inline">{s.name}</span>
              </a>
            </li>
            {i < socials.length - 1 && <li class="text-mist/20" aria-hidden="true">|</li>}
          </>
        ))}
      </ul>
    </div>
  </div>
</footer>
