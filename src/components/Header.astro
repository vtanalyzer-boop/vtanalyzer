---
import Logo from "./Logo.astro";
import { languages } from "../data/languages";

const nav = [
  { href: "/", label: "Home" },
  { href: "/how-it-works/", label: "How It Works" },
  { href: "/faq/", label: "FAQ" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line dark:border-seam bg-paper/90 dark:bg-night/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-4">
    <Logo class="text-ink dark:text-fog" />

    <nav class="hidden items-center gap-7 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "text-sm font-medium transition-colors hover:text-red",
            current === item.href ? "text-red" : "text-ink/75 dark:text-smoke",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <!-- Language switcher -->
      <div class="relative">
        <button
          id="lang-toggle"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Choose language"
          class="notranslate flex h-9 items-center gap-1.5 rounded-md border border-line dark:border-seam px-2.5 text-xs font-semibold text-ink/75 dark:text-smoke transition-colors hover:border-red/50 hover:text-red"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
            <path d="M3 12H21M12 3C14.5 5.7 15.8 8.8 15.8 12C15.8 15.2 14.5 18.3 12 21C9.5 18.3 8.2 15.2 8.2 12C8.2 8.8 9.5 5.7 12 3Z" stroke="currentColor" stroke-width="1.6" />
          </svg>
          <span id="lang-current" class="hidden sm:inline">EN</span>
        </button>
        <div
          id="lang-menu"
          role="menu"
          class="notranslate absolute right-0 top-11 hidden max-h-80 w-48 overflow-y-auto rounded-md border border-line dark:border-seam bg-card dark:bg-charcoal py-1.5 shadow-lg"
        >
          {languages.map((l) => (
            <button
              type="button"
              class="lang-option flex w-full items-center justify-between px-3.5 py-2 text-left text-sm text-ink/80 dark:text-smoke hover:bg-red/10 hover:text-red"
              data-lang={l.code}
            >
              <span>{l.native}</span>
              <span class="text-xs text-ink/40 dark:text-smoke">{l.code.toUpperCase()}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        aria-pressed="false"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-line dark:border-seam text-ink/75 dark:text-smoke transition-colors hover:border-red/50 hover:text-red"
      >
        <svg id="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8" />
          <path d="M12 2.5V5M12 19V21.5M4.2 4.2L6 6M18 18L19.8 19.8M2.5 12H5M19 12H21.5M4.2 19.8L6 18M18 6L19.8 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <svg id="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
      </button>

      <a
        href="/#analyzer"
        class="hidden rounded-md bg-red px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-red-dark lg:inline-block"
      >
        Analyze Thumbnail
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-line dark:border-seam text-ink dark:text-fog lg:hidden"
      >
        <svg id="menu-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3 6H21M3 12H21M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg id="menu-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden" aria-hidden="true">
          <path d="M6 6L18 18M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line dark:border-seam bg-paper dark:bg-night lg:hidden">
    <ul class="flex flex-col gap-1 px-5 py-4">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "mobile-nav-link block rounded-md px-3 py-2.5 text-sm font-medium",
              current === item.href ? "bg-red/10 text-red" : "text-ink/80 dark:text-smoke",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    function ready(fn) {
      if (document.readyState !== "loading") fn();
      else document.addEventListener("DOMContentLoaded", fn);
    }

    ready(function () {
      /* ---------- Mobile menu ---------- */
      var toggle = document.getElementById("menu-toggle");
      var mobileNav = document.getElementById("mobile-nav");
      var iconOpen = document.getElementById("menu-icon-open");
      var iconClose = document.getElementById("menu-icon-close");

      function closeMenu() {
        if (!mobileNav) return;
        mobileNav.classList.add("hidden");
        iconOpen && iconOpen.classList.remove("hidden");
        iconClose && iconClose.classList.add("hidden");
        toggle && toggle.setAttribute("aria-expanded", "false");
      }

      function openMenu() {
        if (!mobileNav) return;
        mobileNav.classList.remove("hidden");
        iconOpen && iconOpen.classList.add("hidden");
        iconClose && iconClose.classList.remove("hidden");
        toggle && toggle.setAttribute("aria-expanded", "true");
      }

      if (toggle && mobileNav) {
        toggle.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (mobileNav.classList.contains("hidden")) openMenu();
          else closeMenu();
        });

        document.querySelectorAll(".mobile-nav-link").forEach(function (link) {
          link.addEventListener("click", closeMenu);
        });

        document.addEventListener("click", function (e) {
          if (!mobileNav.classList.contains("hidden") && !mobileNav.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
            closeMenu();
          }
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeMenu();
        });

        window.addEventListener("resize", function () {
          if (window.innerWidth >= 1024) closeMenu();
        });
      }

      /* ---------- Theme toggle ---------- */
      var themeToggle = document.getElementById("theme-toggle");
      var sunIcon = document.getElementById("theme-icon-sun");
      var moonIcon = document.getElementById("theme-icon-moon");
      var root = document.documentElement;

      function applyTheme(isDark) {
        root.classList.toggle("dark", isDark);
        if (sunIcon && moonIcon) {
          sunIcon.classList.toggle("hidden", isDark);
          moonIcon.classList.toggle("hidden", !isDark);
        }
        themeToggle && themeToggle.setAttribute("aria-pressed", String(isDark));
      }

      var saved = null;
      try {
        saved = localStorage.getItem("vt-theme");
      } catch (err) {}
      var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
      applyTheme(saved ? saved === "dark" : prefersDark);

      themeToggle &&
        themeToggle.addEventListener("click", function () {
          var isDark = !root.classList.contains("dark");
          applyTheme(isDark);
          try {
            localStorage.setItem("vt-theme", isDark ? "dark" : "light");
          } catch (err) {}
        });

      /* ---------- Language switcher ---------- */
      var langToggle = document.getElementById("lang-toggle");
      var langMenu = document.getElementById("lang-menu");
      var langCurrent = document.getElementById("lang-current");

      function closeLangMenu() {
        langMenu && langMenu.classList.add("hidden");
        langToggle && langToggle.setAttribute("aria-expanded", "false");
      }

      langToggle &&
        langMenu &&
        langToggle.addEventListener("click", function (e) {
          e.stopPropagation();
          var isHidden = langMenu.classList.contains("hidden");
          langMenu.classList.toggle("hidden");
          langToggle.setAttribute("aria-expanded", String(isHidden));
        });

      document.addEventListener("click", function (e) {
        if (langMenu && !langMenu.classList.contains("hidden") && !langMenu.contains(e.target) && e.target !== langToggle) {
          closeLangMenu();
        }
      });

      document.querySelectorAll(".lang-option").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var code = btn.getAttribute("data-lang");
          if (langCurrent) langCurrent.textContent = code.toUpperCase();
          closeLangMenu();
          if (window.vtTranslateTo) window.vtTranslateTo(code);
        });
      });

      try {
        var savedLang = localStorage.getItem("vt-lang");
        if (savedLang && langCurrent) langCurrent.textContent = savedLang.toUpperCase();
      } catch (err) {}
    });
  })();
</script>
