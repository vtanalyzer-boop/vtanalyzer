---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

// Self-hosted fonts: served from our own origin (bundled + long-cache headers
// already cover /_astro/*), instead of round-tripping to fonts.googleapis.com
// and fonts.gstatic.com before the page's headline text can render in its
// final font. Scoped to the "latin" subset only (this site is English-only) —
// the unscoped imports pull in cyrillic/greek/vietnamese subsets too, which
// bloats the generated stylesheet ~10x and was hurting Speed Index and TBT.
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/space-grotesk/latin-600.css";
import "@fontsource/space-grotesk/latin-700.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/inter/latin-800.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-700.css";

export interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { title, description, path, ogImage, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} path={path} ogImage={ogImage} noindex={noindex} jsonLd={jsonLd} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Apply saved/system theme before first paint to avoid a light/dark flash -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("vt-theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (saved ? saved === "dark" : prefersDark) {
            document.documentElement.classList.add("dark");
          }
        } catch (err) {}
      })();
    </script>
  </head>
  <body class="font-body antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-red-dark focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Multi-language support: Google Website Translator, driven by the
         custom language switcher in the header (no default widget UI shown). -->
    <div id="google_translate_element" class="notranslate" aria-hidden="true"></div>

    <!-- Third-party scripts (Google Analytics + Google Translate) are loaded
         together, after the page has painted. Both are fetched on whichever
         happens first: the browser going idle, the user interacting with the
         page, or a short safety timeout — so they never compete with critical
         CSS/JS for bandwidth or the main thread during First/Largest
         Contentful Paint, but still load quickly for real visitors. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-TPRE21PBVE");

      function googleTranslateElementInit() {
        try {
          new google.translate.TranslateElement(
            { pageLanguage: "en", autoDisplay: false },
            "google_translate_element"
          );
        } catch (err) {}

        try {
          var saved = localStorage.getItem("vt-lang");
          if (saved && saved !== "en") {
            var tries = 0;
            var poll = setInterval(function () {
              var select = document.querySelector(".goog-te-combo");
              tries++;
              if (select) {
                select.value = saved;
                select.dispatchEvent(new Event("change"));
                clearInterval(poll);
              } else if (tries > 20) {
                clearInterval(poll);
              }
            }, 250);
          }
        } catch (err) {}
      }
      window.googleTranslateElementInit = googleTranslateElementInit;

      window.vtTranslateTo = function (code) {
        try {
          localStorage.setItem("vt-lang", code);
        } catch (err) {}

        if (code === "en") {
          document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
          location.reload();
          return;
        }

        var select = document.querySelector(".goog-te-combo");
        if (select) {
          select.value = code;
          select.dispatchEvent(new Event("change"));
        } else {
          document.cookie = "googtrans=/en/" + code + "; path=/;";
          location.reload();
        }
      };

      (function () {
        var loaded = false;
        function loadThirdParty() {
          if (loaded) return;
          loaded = true;

          var ga = document.createElement("script");
          ga.src = "https://www.googletagmanager.com/gtag/js?id=G-TPRE21PBVE";
          ga.async = true;
          document.head.appendChild(ga);

          var tr = document.createElement("script");
          tr.src = "https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit";
          tr.async = true;
          document.body.appendChild(tr);
        }

        ["scroll", "keydown", "mousemove", "touchstart", "pointerdown"].forEach(function (evt) {
          window.addEventListener(evt, loadThirdParty, { once: true, passive: true });
        });

        if ("requestIdleCallback" in window) {
          requestIdleCallback(loadThirdParty, { timeout: 4000 });
        } else {
          window.addEventListener("load", function () {
            setTimeout(loadThirdParty, 2000);
          });
        }
      })();
    </script>
  </body>
</html>
