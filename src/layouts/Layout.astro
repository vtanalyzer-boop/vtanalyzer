---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { title, description, path, ogImage, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} path={path} ogImage={ogImage} noindex={noindex} jsonLd={jsonLd} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TPRE21PBVE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-TPRE21PBVE');
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Apply saved/system theme before first paint to avoid a light/dark flash -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("vt-theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (saved ? saved === "dark" : prefersDark) {
            document.documentElement.classList.add("dark");
          }
        } catch (err) {}
      })();
    </script>
  </head>
  <body class="font-body antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-red focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Multi-language support: Google Website Translator, driven by the
         custom language switcher in the header (no default widget UI shown). -->
    <div id="google_translate_element" class="notranslate" aria-hidden="true"></div>
    <script is:inline>
      function googleTranslateElementInit() {
        try {
          new google.translate.TranslateElement(
            { pageLanguage: "en", autoDisplay: false },
            "google_translate_element"
          );
        } catch (err) {}

        try {
          var saved = localStorage.getItem("vt-lang");
          if (saved && saved !== "en") {
            var tries = 0;
            var poll = setInterval(function () {
              var select = document.querySelector(".goog-te-combo");
              tries++;
              if (select) {
                select.value = saved;
                select.dispatchEvent(new Event("change"));
                clearInterval(poll);
              } else if (tries > 20) {
                clearInterval(poll);
              }
            }, 250);
          }
        } catch (err) {}
      }
      window.googleTranslateElementInit = googleTranslateElementInit;

      window.vtTranslateTo = function (code) {
        try {
          localStorage.setItem("vt-lang", code);
        } catch (err) {}

        if (code === "en") {
          document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
          location.reload();
          return;
        }

        var select = document.querySelector(".goog-te-combo");
        if (select) {
          select.value = code;
          select.dispatchEvent(new Event("change"));
        } else {
          document.cookie = "googtrans=/en/" + code + "; path=/;";
          location.reload();
        }
      };
    </script>
    <script is:inline async src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
  </body>
</html>
